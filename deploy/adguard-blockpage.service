[Unit]
Description=CSPB AdGuard block page
After=network-online.target AdGuardHome.service
Wants=network-online.target

[Service]
# Copy the repo to /opt/adguard-blockpage and put ADGUARD_USER / ADGUARD_PASSWORD
# (or ADGUARD_PASSWORD_FILE) in /etc/adguard-blockpage.env, mode 600.
EnvironmentFile=/etc/adguard-blockpage.env
ExecStart=/usr/bin/python3 -u /opt/adguard-blockpage/server.py
DynamicUser=yes
# Binding port 80 directly needs this capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
